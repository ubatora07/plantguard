# PlantGuard AI runtime configuration (safe to commit: no secrets here).
# The mobile client must never contain API keys or secrets.

# Diagnosis provider mode: "demo" (offline demo scenarios) or "ai" (real model backend).
# "ai" only takes effect when EXPO_PUBLIC_API_BASE_URL is configured.
EXPO_PUBLIC_DIAGNOSIS_MODE=demo

# Base URL of the future diagnosis backend, e.g. https://api.example.com
# Leave empty while the real model is not connected.
EXPO_PUBLIC_API_BASE_URL=
