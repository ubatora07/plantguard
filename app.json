{
  "expo": {
    "name": "PlantGuard AI",
    "slug": "plantguard-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "plantguard",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7FAF7",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.plantguardai.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Приложению нужен доступ к камере, чтобы фотографировать листья растений для проверки.",
        "NSPhotoLibraryUsageDescription": "Приложению нужен доступ к галерее, чтобы выбирать ранее сделанные фото растений."
      }
    },
    "android": {
      "package": "com.plantguardai.app",
      "adaptiveIcon": {
        "backgroundColor": "#F7FAF7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140,
          "backgroundColor": "#F7FAF7"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Приложению нужен доступ к камере, чтобы фотографировать листья растений для проверки.",
          "photosPermission": "Приложению нужен доступ к галерее, чтобы выбирать ранее сделанные фото растений."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Приложению нужен доступ к камере, чтобы фотографировать листья растений для проверки."
        }
      ]
    ]
  }
}
